{
  "name": "speekr",
  "version": "0.0.1",
  "description": "Practice speaking languages locally",
  "type": "module",
  "private": false,
  "bin": {
    "speekr": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "bun src/index.ts",
    "reset-env": "rm -rf ~/.speekr && rm -rf ~/.cache/whisper && rm -rf ~/.cache/huggingface"
  },
  "author": "Divyam gupta",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "find-up": "^8.0.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.1.7",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
