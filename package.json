{
  "name": "speekr",
  "version": "0.0.1",
  "description": "Practice speaking languages locally",
  "type": "module",
  "private": false,
  "bin": {
    "speekr": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "dashboard/dist"
  ],
  "scripts": {
    "build": "pnpm build:dashboard && pnpm build:node",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build:node": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "start": "node dist/index.js",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:dashboard\"",
    "dev:server": "tsx --watch src/server/dev.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "reset-env": "rm -rf ~/.speekr && rm -rf ~/.cache/whisper && rm -rf ~/.cache/huggingface"
  },
  "author": "Divyam gupta",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "find-up": "^8.0.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.1.7",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
